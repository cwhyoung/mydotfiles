import Quickshell
import QtQuick
import QtQuick.Layouts


PanelWindow {
    anchors {
        top: true
        left: true
        right: true
    }

    implicitHeight: 34

    Rectangle {
        anchors.fill: parent
        color: "#1a1b26"

    Text {
        anchors {
            left: parent.left
            verticalCenter: parent.verticalCenter
            leftMargin: 12
        }
        text: "left"
        color: "#cdd6f4"
     }

     Text {
        anchors.centerIn: parent

        text: "center"
        color: "#cdd6f4"
     }

     RowLayout {
        anchors {
            right: parent.right
            verticalCenter: parent.verticalCenter
            rightMargin: 20
        }

        spacing: 10


        Text { text: "vol"; color: "#fab387" }
        Text { text: "bat"; color: "#9ece6a" }
        Text { text: "12:00"; color: "#cdd6f4" }


    }

    }
}
